# PDN Multimodal Knowledge Sync — Environment Configuration Example
# Copy to .env and replace placeholder values before running any live verification/discovery.
# Never commit .env or secrets to version control.

# REQUIRED for any live HTTP request (fail-closed if missing or placeholder).
# Sent as: PDN-Knowledge-Sync/0.1 (+contact: <PDN_CONTACT_EMAIL>)
PDN_CONTACT_EMAIL=your-email@example.com

# Operator identifier recorded in audit trails (not a personal secret)
PDN_OPERATOR_ID=project-owner

# Explicit opt-in gates for live network operations (Phase 0 defaults to safe/disabled)
PDN_SOURCE_POLICY_ACKNOWLEDGED=false
PDN_LIVE_CRAWL_ENABLED=false

# Local paths (relative to repo root or absolute)
PDN_SCOPE_FILE=config/crawl_scope.yaml
PDN_INGESTION_POLICY_FILE=config/ingestion_policy.yaml
PDN_DATA_DIR=data
PDN_SQLITE_PATH=data/pdn_sync.db

# Politeness & safety bounds (Section 2 Rule 2 & Section 6)
PDN_MAX_CONCURRENCY_PER_HOST=1
PDN_DELAY_MIN_SECONDS=2.0
PDN_DELAY_MAX_SECONDS=5.0
PDN_REQUEST_TIMEOUT_SECONDS=20.0
PDN_MAX_DOCUMENT_BYTES=52428800
